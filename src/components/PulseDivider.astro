---
/**
 * Divisor con pulso (EKG) según asset `pulso.png`.
 * La línea se estira; el pulso mantiene su proporción para no aplanarse.
 */
interface Props {
	class?: string;
	/** Posición del pulso sobre la línea */
	align?: "start" | "end";
}

const { class: className = "", align = "start" } = Astro.props;

/**
 * Geometría del asset 1768×286:
 * baseline y=195, pico ≈(924,2), valle ≈(1056,282)
 * Recorte local del pulso con stubs cortos a cada lado.
 */
const pulsePath = "M0 195 H18 L104 2 L236 282 L274 195 H292";
---

<div
	class:list={[
		"flex w-full items-stretch text-current",
		align === "end" && "flex-row-reverse",
		className,
	]}
	aria-hidden="true"
>
	<svg
		class="h-full w-auto shrink-0"
		viewBox="0 0 292 286"
		fill="none"
		xmlns="http://www.w3.org/2000/svg"
		preserveAspectRatio="xMidYMid meet"
	>
		<path
			d={pulsePath}
			stroke="currentColor"
			stroke-width="8"
			stroke-linejoin="miter"
			stroke-linecap="square"
		/>
	</svg>

	<div class="relative min-w-0 flex-1">
		<span
			class="absolute right-0 left-0 h-[0.14em] min-h-[2px] bg-current"
			style="top: calc(195 / 286 * 100%); transform: translateY(-50%)"
		/>
	</div>
</div>
