---
/**
 * Divisor naranja con pulso (EKG) — SVG para nitidez a cualquier ancho.
 */
interface Props {
	class?: string;
	/** Posición del pulso sobre la línea */
	align?: "start" | "end";
}

const { class: className = "", align = "start" } = Astro.props;
---

<svg
	class:list={[className, align === "end" && "-scale-x-100"]}
	viewBox="0 0 1200 40"
	fill="none"
	xmlns="http://www.w3.org/2000/svg"
	aria-hidden="true"
	preserveAspectRatio="none"
>
	<path
		d="M0 20 H220 L250 4 L280 36 L310 20 H1200"
		stroke="currentColor"
		stroke-width="2.5"
		stroke-linejoin="miter"
		stroke-linecap="square"
	/>
</svg>
