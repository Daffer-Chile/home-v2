---
/**
 * Divisor con pulso (EKG) según asset `pulso.png`.
 * La línea se estira; el pulso mantiene su proporción para no aplanarse.
 */
interface Props {
	class?: string;
	/** Posición del pulso sobre la línea */
	align?: "start" | "end";
}

const { class: className = "", align = "start" } = Astro.props;

/** Grosor visual compartido entre pulso y tramos de línea (px). */
const strokePx = 3;

/**
 * Geometría del asset 1768×286:
 * baseline y=195, pico ≈(924,2), valle ≈(1056,282)
 */
const pulsePath = "M0 195 L86 2 L218 282 L256 195";
const baselineTop = "calc(195 / 286 * 100%)";
---

<div
	class:list={[
		"flex w-full items-stretch text-current",
		align === "end" && "flex-row-reverse",
		className,
	]}
	aria-hidden="true"
>
	{/* Tramo inicial: separa el pulso del borde (120px en desktop) */}
	<div class="relative w-10 shrink-0 sm:w-16 md:w-[120px]">
		<span
			class="absolute right-0 left-0 bg-current"
			style={`top: ${baselineTop}; height: ${strokePx}px; transform: translateY(-50%)`}
		/>
	</div>

	<svg
		class="h-full w-auto shrink-0"
		viewBox="0 0 256 286"
		fill="none"
		xmlns="http://www.w3.org/2000/svg"
		preserveAspectRatio="xMidYMid meet"
		overflow="visible"
	>
		<path
			d={pulsePath}
			stroke="currentColor"
			stroke-width={strokePx}
			stroke-linejoin="miter"
			stroke-linecap="square"
			vector-effect="non-scaling-stroke"
		/>
	</svg>

	<div class="relative min-w-0 flex-1">
		<span
			class="absolute right-0 left-0 bg-current"
			style={`top: ${baselineTop}; height: ${strokePx}px; transform: translateY(-50%)`}
		/>
	</div>
</div>
