---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import PulseDivider from "@/components/PulseDivider.astro";

interface Props {
	title: string;
	image?: ImageMetadata;
	imageAlt?: string;
	variant?: "image" | "shape";
}

const { title, image, imageAlt = "", variant = "image" } = Astro.props;
---

<section class="relative bg-white">
	<div
		class="container-page relative overflow-hidden px-4 sm:px-6 lg:px-8"
	>
		{
			variant === "image" && image ? (
				<div
					class="pointer-events-none absolute inset-y-0 right-0 hidden w-[55%] overflow-hidden md:block"
					aria-hidden="true"
				>
					<Image
						src={image}
						alt=""
						class="h-full w-full object-cover clip-hero-diagonal"
						widths={[700, 1000, 1200]}
						sizes="(max-width: 1200px) 55vw, 660px"
						priority
					/>
				</div>
			) : (
				<div
					class="pointer-events-none absolute inset-y-0 right-0 hidden w-[55%] overflow-hidden md:block"
					aria-hidden="true"
				>
					<div class="h-full w-full bg-brand clip-hero-diagonal" />
				</div>
			)
		}

		<div
			class="relative flex min-h-[16rem] max-w-md flex-col justify-center py-14 sm:min-h-[18rem] md:min-h-[20rem] md:py-16"
		>
			<h1
				class="font-display text-left text-5xl leading-[1.05] font-extrabold tracking-tight text-foreground sm:text-6xl md:text-7xl"
			>
				{title}
			</h1>
		</div>

		{
			variant === "image" && image ? (
				<div class="-mx-4 mt-2 md:hidden sm:-mx-6">
					<Image
						src={image}
						alt={imageAlt}
						class="h-48 w-full object-cover sm:h-56"
						widths={[640, 960]}
						sizes="100vw"
						priority
					/>
				</div>
			) : (
				<div class="-mx-4 mt-2 h-40 bg-brand md:hidden sm:-mx-6 sm:h-48" aria-hidden="true" />
			)
		}
	</div>

	<div class="px-4 pt-2 pb-3 sm:px-6 lg:px-8">
		<div class="container-page text-brand">
			<PulseDivider class="h-8 w-full sm:h-10" />
		</div>
	</div>
</section>
