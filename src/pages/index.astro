---
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import heroHome from "@/assets/photos/hero-home.png";
import pulso from "@/assets/recursos/pulso.png";
import paralelogramos from "@/assets/recursos/paralelogramos.png";
---

<Layout title="Inicio">
	<section class="relative overflow-hidden bg-white">
		<div class="mx-auto grid max-w-6xl items-stretch md:grid-cols-2">
			<div class="flex flex-col justify-center px-4 py-16 sm:px-6 md:py-24 lg:px-8">
				<h1
					class="font-display text-4xl leading-[1.05] font-extrabold tracking-tight text-foreground sm:text-5xl lg:text-6xl"
				>
					Técnica, Experiencia<br />
					y Criterio para la
					<span class="text-brand"> Industria</span>
				</h1>
			</div>

			<div class="min-h-64 md:min-h-[28rem]">
				<Image
					src={heroHome}
					alt="Operación industrial minera con correas transportadoras"
					class="h-full min-h-64 w-full object-cover md:min-h-[28rem] clip-hero-diagonal"
					widths={[640, 960, 1280]}
					sizes="(max-width: 768px) 100vw, 50vw"
					priority
				/>
			</div>
		</div>
	</section>

	<section class="relative overflow-hidden bg-white px-4 py-16 sm:px-6 lg:px-8">
		<Image
			src={paralelogramos}
			alt=""
			aria-hidden="true"
			class="pointer-events-none absolute top-8 right-4 hidden h-40 w-auto opacity-40 md:block lg:right-16"
			widths={[200, 320]}
			sizes="160px"
		/>

		<div class="mx-auto max-w-3xl text-center">
			<p class="text-base leading-relaxed text-muted-foreground sm:text-lg">
				DAFFER Ingeniería & Mantenimiento ofrece servicios de mantenimiento
				predictivo, inspección técnica y confiabilidad operacional para activos
				críticos industriales. Cuenta con un equipo con más de 20 años de
				experiencia certificada en técnicas predictivas y entrega soluciones
				personalizadas según la complejidad e historial operativo de cada planta.
			</p>

			<div class="mt-10 flex flex-col items-center gap-3">
				<Image
					src={pulso}
					alt=""
					aria-hidden="true"
					class="h-6 w-40 object-contain"
					widths={[200, 320]}
					sizes="160px"
				/>
				<p class="font-display text-lg font-semibold text-foreground sm:text-xl">
					+20 años de
					<span class="text-brand">experiencia certificada</span>
				</p>
			</div>
		</div>
	</section>
</Layout>
