---
import { Image } from "astro:assets";
import { BadgeCheck } from "@lucide/astro";
import Layout from "@/layouts/Layout.astro";
import PulseDivider from "@/components/PulseDivider.astro";
import heroHome from "@/assets/photos/hero-home.png";
import chevron from "@/assets/recursos/chevron.png";
import paralelogramos from "@/assets/recursos/paralelogramos.png";
---

<Layout title="Inicio">
	<section class="relative bg-white">
		{/* Bloque visual del hero — overflow contenido aquí para no desbordar el divisor */}
		<div class="relative overflow-hidden">
			{/* Imagen hero con corte diagonal — desktop */}
			<div
				class="pointer-events-none absolute inset-y-0 right-0 hidden w-[min(62%,720px)] overflow-hidden md:block lg:w-[58%]"
				aria-hidden="true"
			>
				<Image
					src={heroHome}
					alt=""
					class="h-full w-full max-w-none object-cover clip-hero-diagonal"
					widths={[800, 1200, 1600]}
					sizes="58vw"
					priority
				/>
			</div>

			<div class="container-page relative px-4 sm:px-6 lg:px-8">
				<div
					class="flex min-h-[24rem] max-w-md flex-col justify-center py-20 sm:min-h-[28rem] md:min-h-[32rem] md:py-24"
				>
					<h1
						class="font-display text-left text-4xl leading-[1.05] font-extrabold tracking-tight text-foreground sm:text-5xl lg:text-6xl"
					>
						Técnica, Experiencia<br />
						y Criterio para la<br />
						<span class="text-brand">Industria</span>
					</h1>
				</div>
			</div>

			{/* Imagen mobile (sin clip) */}
			<div class="md:hidden">
				<Image
					src={heroHome}
					alt="Operación industrial minera con correas transportadoras"
					class="h-56 w-full object-cover sm:h-72"
					widths={[640, 960]}
					sizes="100vw"
				/>
			</div>
		</div>

		{/* Divisor naranja / pulso bajo el hero */}
		<div class="relative z-10 bg-white px-4 pt-2 pb-3 sm:px-6 lg:px-8">
			<div class="container-page text-brand">
				<PulseDivider class="h-8 w-full sm:h-10" />
			</div>
		</div>
	</section>

	<section class="relative overflow-hidden bg-white px-4 py-24 sm:px-6 sm:py-28 lg:px-8 lg:py-32">
		{/* Recurso 3 — chevron normal (gris vía CSS sobre el asset original) */}
		<Image
			src={chevron}
			alt=""
			aria-hidden="true"
			class="pointer-events-none absolute inset-x-0 top-0 mx-auto h-full max-h-none w-full max-w-[1200px] object-cover object-top opacity-[0.14] brightness-0"
			widths={[800, 1200]}
			sizes="1200px"
		/>

		{/* Paralelogramos naranja — más grandes */}
		<Image
			src={paralelogramos}
			alt=""
			aria-hidden="true"
			class="pointer-events-none absolute top-1/2 right-0 hidden h-72 w-auto -translate-y-1/2 opacity-80 md:block lg:right-[max(0px,calc((100%-1200px)/2))] lg:h-80 xl:h-96"
			widths={[280, 400, 520]}
			sizes="320px"
		/>

		<div class="container-page relative">
			<p class="max-w-[42rem] text-left text-base leading-relaxed text-foreground sm:text-lg">
				<strong>DAFFER Ingeniería & Mantenimiento</strong> ofrece servicios de
				<strong> mantenimiento predictivo</strong>,
				<strong> inspección técnica</strong> y
				<strong> confiabilidad operacional</strong> para activos críticos
				industriales. Cuenta con un equipo con
				<strong> más de 20 años de experiencia certificada</strong> en técnicas
				predictivas y entrega
				<strong> soluciones personalizadas</strong> según la complejidad e
				historial operativo de cada planta.
			</p>

			<div class="mt-14 flex items-center justify-center gap-3">
				<span class="text-brand" aria-hidden="true">
					<BadgeCheck size={28} stroke-width={2.25} />
				</span>
				<p class="font-display text-lg font-bold text-foreground sm:text-xl">
					+20 años de
					<span class="text-brand"> experiencia certificada</span>
				</p>
			</div>
		</div>
	</section>
</Layout>
